00000000          ; test07.asm
00000000          ; Sort a given array using Bubble Sort
00000000          ;
00000000 00100000         ldc 0x1000  ; Assuming 0x1000 to be the start of the stack memory as been done in sample program 4 in the project pdf
00000001 0000000B         a2sp
00000002 FFFFFF0A         adj -1
00000003 00000007         sub         ; to make A = 0
00000004 00000000         ldc 0       ; to make A = 0, B = 0
00000005 0000000D         call main
00000006          ;
00000006 00003D00 main:   ldc arr
00000007 FFFFFF03         stl -1      ; SP[1] stores the ptr to the current array element for the main loop, i.e. SP[1] = i
00000008 00003C00         ldc n
00000009 00000004         ldnl 0
0000000A                  ; adc -1   
0000000A 00000003         stl 0       ; SP[0] stores the number of instructions left to evaluate for the main loop, i.e. SP[0] = n-1
0000000B          ;
0000000B 00000002 loop:   ldl 0
0000000C 00002D0F         brz end
0000000D 00003D00         ldc arr
0000000E FFFFFD03         stl -3      ; SP[3] stores the ptr to the current array element for the sub loop, i.e. SP[3] = j
0000000F 00003C00         ldc n
00000010 00000004         ldnl 0
00000011 FFFFFF01         adc -1   
00000012 FFFFFE03         stl -2      ; SP[2] stores the number of instructions left to evaluate for the sub loop, i.e. SP[2] = n-1
00000013 FFFFFE02 sloop:  ldl -2
00000014 00001E0F         brz subend
00000015 FFFFFF02         ldl -1      ; A = i   
00000016 00000004         ldnl 0      ; A = arr[i]
00000017 FFFFFD02         ldl -3      ; B = arr[i], A = j
00000018 00000004         ldnl 0      ; A = arr[j]
00000019 00000007         sub         ; A = arr[i] - arr[j]
0000001A 00000710         brlz swap
0000001B FFFFFD02         ldl -3      ; A = j
0000001C 00000101         adc 1       ; j = j + 1
0000001D FFFFFD03         stl -3      ; SP[3] = j+1
0000001E FFFFFE02         ldl -2      ; A = SP[2]
0000001F FFFFFF01         adc -1      ; A = SP[2] - 1
00000020 FFFFFE03         stl -2      ; SP[2] = SP[2] - 1
00000021 FFFFF111         br sloop
00000022          ;
00000022 FFFFFF02 swap:   ldl -1      ; A = i
00000023 00000004         ldnl 0      ; A = arr[i]
00000024 FFFFFC03         stl -4      ; SP[4] stores the temporary value used for swapping, i.e. SP[4] = temp
00000025 FFFFFD02         ldl -3      ; B = arr[i], A = j
00000026 00000004         ldnl 0      ; A = arr[j]
00000027 FFFFFF02         ldl -1      ; B = arr[j], A = i
00000028 00000005         stnl 0      ; arr[i] = arr[j]
00000029 FFFFFC02         ldl -4      ; A = temp
0000002A FFFFFD02         ldl -3      ; B = temp, A = j
0000002B 00000005         stnl 0      ; arr[j] = temp
0000002C FFFFFD02         ldl -3      ; A = j
0000002D 00000101         adc 1       ; j = j + 1
0000002E FFFFFD03         stl -3      ; SP[3] = j + 1
0000002F FFFFFE02         ldl -2      ; A = SP[2]
00000030 FFFFFF01         adc -1      ; A = SP[2] - 1
00000031 FFFFFE03         stl -2      ; SP[2] = SP[2] - 1
00000032 FFFFE011         br sloop
00000033          ;
00000033 FFFFFF02 subend: ldl -1      ; A = i
00000034 00000101         adc 1       ; i = i + 1
00000035 FFFFFF03         stl -1      ; SP[1] = i + 1
00000036 00000002         ldl 0       ; A = SP[0]
00000037 FFFFFF01         adc -1      ; A = SP[0] - 1
00000038 00000003         stl 0       ; SP[0] = SP[0] - 1
00000039 FFFFD111         br loop
0000003A          ;
0000003A 0000010A end:    adj 1
0000003B 00000012         HALT
0000003C          ;
0000003C 0000000A n:      data 10
0000003D FFFFFFFB arr:    data -5
0000003E 0000000A         data 10
0000003F 00000003         data 3
00000040 0000000F         data 15
00000041 FFFFFFF1         data -15
00000042 00000006         data 6
00000043 FFFFFFF6         data -10
00000044 00000008         data 8
00000045 FFFFFFFD         data -3
00000046 00000007         data 7
