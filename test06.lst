00000000          ; test06.asm 
00000000          ; Program to print first n fibonacci numbers
00000000          
00000000 00100000         ldc 0x1000  ; Assuming 0x1000 to be the start of the stack memory as been done in sample program 4 in the project pdf
00000001 0000000B         a2sp
00000002 FFFFFF0A         adj -1
00000003 00000007         sub         ; to make A = 0
00000004 00000000         ldc 0       ; to make A=0 and B=0
00000005 0000000D         call main
00000006          ;
00000006 00002100 main:   ldc arr
00000007 00000201         adc 2
00000008 FFFFFF03         stl -1      ; SP[0] stores ptr to write into memory, i.e. SP[0] = i
00000009 00002000         ldc n
0000000A 00000004         ldnl 0
0000000B FFFFFE01         adc -2
0000000C 00000003         stl  0      ; SP[1] stores the number of elements yet to be written into the array, initially SP[0] = n-2 since first two fibonacci numbers till n are 0 and 1
0000000D          ;
0000000D 00000002 loop:   ldl 0       ; A = SP[1]
0000000E 00000F0F         brz end
0000000F FFFFFF02         ldl -1      ; A = i
00000010 FFFFFF01         adc -1      ; i-1
00000011 00000004         ldnl 0      ; A = arr[i-1]
00000012 FFFFFF02         ldl -1      ; B = arr[i-1], A=i
00000013 FFFFFE01         adc -2      ; i-2
00000014 00000004         ldnl 0      ; A = arr[i-2]
00000015 00000006         add         ; A = arr[i-1] + arr[i-2]
00000016 FFFFFF02         ldl -1      ; B = arr[i-1] + arr[i-2], A=i
00000017 00000005         stnl 0      ; arr[i] = B
00000018 00000101         adc 1       ; A = i+1
00000019 FFFFFF03         stl -1      ; SP[0] = i+1
0000001A 00000002         ldl 0       ; A = n-2
0000001B FFFFFF01         adc -1      ; A = n-3
0000001C 00000003         stl 0       ; SP[0] = n-3
0000001D FFFFEF11         br loop
0000001E          ;
0000001E 0000010A end:    adj 1
0000001F 00000012         HALT
00000020          ;
00000020 0000000F n:      data 15
00000021 00000000 arr:    data 0
00000022 00000001         data 1
